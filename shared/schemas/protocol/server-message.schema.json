{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schmegettes.dev/schemas/protocol/server-message.schema.json",
  "title": "ServerMessage",
  "description": "Every message the game server sends. seq increases by one per room; a client that sees a gap requests a fresh snapshot by reconnecting.",
  "oneOf": [
    {
      "$ref": "#/$defs/RoomSnapshot"
    },
    {
      "$ref": "#/$defs/LobbyUpdated"
    },
    {
      "$ref": "#/$defs/RoomClosed"
    },
    {
      "$ref": "#/$defs/PhaseChanged"
    },
    {
      "$ref": "#/$defs/BuzzResult"
    },
    {
      "$ref": "#/$defs/AnswerJudged"
    },
    {
      "$ref": "#/$defs/TimerTick"
    },
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Pong"
    }
  ],
  "$defs": {
    "Player": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "displayName": {
          "type": "string",
          "maxLength": 40
        },
        "role": {
          "$ref": "../domain.schema.json#/$defs/PlayerRole"
        },
        "score": {
          "type": "integer"
        },
        "connected": {
          "type": "boolean"
        }
      },
      "required": ["userId", "displayName", "role", "score", "connected"],
      "additionalProperties": false
    },
    "BoardClue": {
      "description": "A clue as players see it. clueText is present only once the clue is revealed; the correct response is never sent before judging.",
      "type": "object",
      "properties": {
        "clueId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "category": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        },
        "state": {
          "$ref": "../domain.schema.json#/$defs/ClueState"
        },
        "clueText": {
          "type": "string"
        }
      },
      "required": ["clueId", "category", "value", "state"],
      "additionalProperties": false
    },
    "RoomSnapshot": {
      "description": "Full state, sent on connect and reconnect. In the lobby, round is single, board is empty, and the lobby fields are present.",
      "type": "object",
      "properties": {
        "type": {
          "const": "room_snapshot"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "$ref": "../domain.schema.json#/$defs/GamePhase"
        },
        "round": {
          "$ref": "../domain.schema.json#/$defs/Round"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Player"
          }
        },
        "board": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoardClue"
          }
        },
        "controllingUserId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "activeClueId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "hostDisplayName": {
          "type": "string"
        },
        "hostPlays": {
          "type": "boolean"
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 2
        }
      },
      "required": ["type", "roomId", "seq", "phase", "round", "players", "board"],
      "additionalProperties": false
    },
    "LobbyUpdated": {
      "description": "The lobby changed: someone joined, left, renamed, connected or disconnected, or the host joined or left the game. players is in join order; the host is listed only when hostPlays.",
      "type": "object",
      "properties": {
        "type": {
          "const": "lobby_updated"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "hostUserId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "hostDisplayName": {
          "type": "string"
        },
        "hostPlays": {
          "type": "boolean"
        },
        "maxPlayers": {
          "type": "integer",
          "minimum": 2
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Player"
          }
        }
      },
      "required": ["type", "roomId", "seq", "hostUserId", "hostDisplayName", "hostPlays", "maxPlayers", "players"],
      "additionalProperties": false
    },
    "RoomClosed": {
      "description": "The room closed. host_absent: no host device for 30 minutes in the lobby. replaced: the host created a new room.",
      "type": "object",
      "properties": {
        "type": {
          "const": "room_closed"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": ["host_absent", "replaced"]
        }
      },
      "required": ["type", "roomId", "seq", "reason"],
      "additionalProperties": false
    },
    "PhaseChanged": {
      "type": "object",
      "properties": {
        "type": {
          "const": "phase_changed"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "$ref": "../domain.schema.json#/$defs/GamePhase"
        },
        "activeClue": {
          "$ref": "#/$defs/BoardClue"
        },
        "deadlineAt": {
          "type": "integer",
          "description": "Server clock, ms since epoch, when this phase times out."
        }
      },
      "required": ["type", "roomId", "seq", "phase"],
      "additionalProperties": false
    },
    "BuzzResult": {
      "type": "object",
      "properties": {
        "type": {
          "const": "buzz_result"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "userId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "outcome": {
          "type": "string",
          "enum": ["won", "too_late", "locked_out"]
        },
        "lockoutUntil": {
          "type": "integer"
        }
      },
      "required": ["type", "roomId", "seq", "userId", "outcome"],
      "additionalProperties": false
    },
    "AnswerJudged": {
      "type": "object",
      "properties": {
        "type": {
          "const": "answer_judged"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "answerId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "userId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "answer": {
          "type": "string"
        },
        "verdict": {
          "$ref": "../domain.schema.json#/$defs/Verdict"
        },
        "correctResponse": {
          "type": "string"
        },
        "scoreDelta": {
          "type": "integer"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "userId -> score after this verdict."
        }
      },
      "required": ["type", "roomId", "seq", "answerId", "userId", "answer", "verdict", "scoreDelta", "scores"],
      "additionalProperties": false
    },
    "TimerTick": {
      "description": "Sent at most once per second. Clients render from deadlineAt and use ticks only to correct drift.",
      "type": "object",
      "properties": {
        "type": {
          "const": "timer_tick"
        },
        "roomId": {
          "$ref": "../domain.schema.json#/$defs/Uuid"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "remainingMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["type", "roomId", "seq", "remainingMs"],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "invalid_message",
            "not_your_turn",
            "not_host",
            "wrong_phase",
            "room_full",
            "internal",
            "not_enough_players",
            "game_started",
            "invalid_name"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["type", "code"],
      "additionalProperties": false
    },
    "Pong": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pong"
        },
        "serverTime": {
          "type": "integer"
        }
      },
      "required": ["type", "serverTime"],
      "additionalProperties": false
    }
  }
}
