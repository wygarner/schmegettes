{
  "name": "schmegettes",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": "1.3.14"
  },
  "workspaces": [
    "shared",
    "web",
    "devtools",
    "e2e"
  ],
  "scripts": {
    "dev": "mise run dev",
    "build": "bun run --cwd shared build && bun run --cwd web build && bun run --cwd devtools build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  },
  "overrides": {
    "ajv": "8.20.0"
  }
}
