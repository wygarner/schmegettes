# Everything here is bundled into the client and readable by anyone. Public-safe values only.
# Copy to web/.env.local. Local development points at local Supabase (`mise run db:start` prints these).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_URL=http://localhost:3001
VITE_STATUS_URL=https://example.instatus.com
# Optional. When unset, Grafana Faro is off (observability.md).
VITE_FARO_URL=
