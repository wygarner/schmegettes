# Copy to api/.env. Local values only; deployed values live in the platform secret store.
PORT=3001
APP_ENV=local
LOG_LEVEL=debug
# app_service role (supabase/seed.sql sets this password locally only)
DATABASE_URL=postgresql://app_service:app-service-local-only@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Public URL of game/ that the API hands to clients when they join a room
GAME_SOCKET_BASE_URL=ws://localhost:3002
# Optional locally. When unset, status-page synchronization is a no-op.
STATUS_PAGE_API_TOKEN=
STATUS_PAGE_ID=
# Optional. When unset, no telemetry is exported (observability.md). Never point local dev at a hosted stack.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
