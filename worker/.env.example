# Copy to worker/.env. Local values only.
APP_ENV=local
LOG_LEVEL=debug
# Queue reads and user-scoped work use app_service.
DATABASE_URL=postgresql://app_service:app-service-local-only@127.0.0.1:54322/postgres
# Catalog imports write the clues table as the owner. Local Supabase's default owner credential.
DATABASE_OWNER_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CLUE_DATASET_BASE_URL=https://raw.githubusercontent.com/wygarner/jeopardy_clue_dataset/refs/heads/main/seasons
# Needed for rating the catalog (rate-clues) and, later, LLM appeal judging
ANTHROPIC_API_KEY=
# The model rate-clues uses (default claude-haiku-5-5)
DIFFICULTY_MODEL=claude-haiku-5-5
